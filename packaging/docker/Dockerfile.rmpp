# Paper Pro (ferrari) cross-build image built from reMarkable's official SDK.
#
# The SDK installer is not downloaded here: its version must match the tablet's
# software version. Put the matching installer in packaging/docker/sdk/ and run
# ./build-rmpp-docker.sh, which passes it in as the build context. See
# packaging/docker/README.md.
#
# reMarkable publishes ferrari SDKs for x86_64 hosts and, from software
# 3.27.0.97, for aarch64 hosts too, so Apple Silicon Macs can build natively.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
# python3, file, and xz/zstd/unzip are what the Yocto-style SDK installer
# checks for; it also forces LC_ALL=en_US.UTF-8, so that locale must exist.
# cmake and ninja are a fallback if the SDK does not ship its own CMake.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    cmake \
    file \
    locales \
    make \
    ninja-build \
    python3 \
    unzip \
    xz-utils \
    zstd \
    && sed -i 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8

ARG SDK_INSTALLER
COPY ${SDK_INSTALLER} /tmp/sdk-installer.sh
RUN chmod +x /tmp/sdk-installer.sh \
    && /tmp/sdk-installer.sh -y -d /opt/rmpp-sdk \
    && rm /tmp/sdk-installer.sh \
    && ls /opt/rmpp-sdk/environment-setup-* >/dev/null

WORKDIR /workspace
CMD ["bash"]
